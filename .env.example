# ===================================================================
# MARKETVOICE SEA — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ===================================================================
# Copy this file to .env and configure local variables.
# NEVER commit the actual .env file to Git version control.

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
RANDOM_SEED=42

# Database Settings (Required for Phase 6+)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=marketvoice_db
POSTGRES_USER=marketvoice_user
POSTGRES_PASSWORD=change_this_password

# API Settings (Required for Phase 11+)
API_HOST=0.0.0.0
API_PORT=8000

# Workflow Settings (Required for Phase 11+)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/simulate-ticket
