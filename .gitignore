!logs/README.txt

# Environment & Credentials
.env
*.env
.venv/
env/
venv/

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# IDE / Editors
.vscode/
.idea/

# OS
Thumbs.db
Desktop.ini
.DS_Store
