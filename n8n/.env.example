# ============================================================
# MarketVoice SEA — n8n Local Runtime Configuration
# ============================================================

# n8n General Configuration
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_DEFAULT_TIMEZONE=Asia/Jakarta
GENERIC_TIMEZONE=Asia/Jakarta

# Execution & Security
N8N_METRICS_ENABLED=true
N8N_LOG_LEVEL=info
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=true

# External Microservice (MarketVoice FastAPI)
MARKETVOICE_API_HOST=localhost
MARKETVOICE_API_PORT=8000
MARKETVOICE_API_URL=http://localhost:8000

# PostgreSQL Data Warehouse
DB_POSTGRESDB_HOST=localhost
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=marketvoice_dev
DB_POSTGRESDB_SCHEMA=marketvoice_warehouse
DB_POSTGRESDB_USER=openpg
DB_POSTGRESDB_PASSWORD=openpgpwd
