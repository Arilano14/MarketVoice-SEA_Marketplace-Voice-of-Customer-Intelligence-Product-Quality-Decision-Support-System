    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "keywords": [
    "marketvoice",
    "n8n",
    "workflow-automation",
    "review-triage",
    "human-in-the-loop",
    "decision-support"
  ],
  "author": "MarketVoice SEA Engineering Team",
