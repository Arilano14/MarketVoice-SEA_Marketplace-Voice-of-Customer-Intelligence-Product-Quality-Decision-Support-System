{
  "name": "marketvoice-sea-n8n",
  "version": "1.0.0",
  "description": "MarketVoice SEA — Operational Automation & Workflow Orchestration with n8n",
  "scripts": {
    "start": "npx n8n start",
    "start:local": "npx n8n start --port 5678",
    "start:tunnel": "npx n8n start --tunnel",
